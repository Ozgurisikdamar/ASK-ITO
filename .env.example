# ---------------------------------------------------------------------------
# Ask ITO - example environment. Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# Database (inside docker-compose the host is `db`; natively use localhost)
DATABASE_URL=postgresql://askito:askito@db:5432/askito

# Embedding model (sentence-transformers). EMBEDDING_DIM must match the model:
#   BAAI/bge-base-en-v1.5  -> 768
#   BAAI/bge-small-en-v1.5 -> 384
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# Cross-encoder reranker (mandatory component; never silently skipped)
#   lighter CPU alternative: cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL=BAAI/bge-reranker-base

# LLM: OpenAI-compatible client abstraction.
#   LLM_MODE=ollama -> talk to an OpenAI-compatible endpoint (default: local Ollama)
#   LLM_MODE=mock   -> deterministic offline stub, no model required (dev/tests)
LLM_MODE=ollama
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
# Model names are read only from here, never hardcoded. Leave a role blank to
# fall back to LLM_DEFAULT_MODEL. Example values below - change to your pulled model.
LLM_DEFAULT_MODEL=qwen3.8:27b
LLM_AGENT_MODEL=
LLM_ANSWER_MODEL=
LLM_JUDGE_MODEL=

# Wikipedia ingest. MediaWiki requires a descriptive User-Agent with a real
# contact (URL or email); a placeholder contact gets HTTP 403. Use your own.
WIKI_USER_AGENT=AskITO/0.1 (+https://github.com/Ozgurisikdamar/ASK-ITO)
WIKI_DELAY=1.0

# Retrieval / agent tuning
AGENT_MAX_ROUNDS=3
FINAL_K=5

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173
