# ---------------------------------------------------------------------------
# Ask ITO - example environment. Copy to .env and adjust. Never commit .env.
# (./askito up creates .env from this file when it is missing.)
# ---------------------------------------------------------------------------

# Database (inside docker-compose the host is `db`; natively use localhost)
DATABASE_URL=postgresql://askito:askito@db:5432/askito

# Embedding model (sentence-transformers). EMBEDDING_DIM must match the model:
#   BAAI/bge-base-en-v1.5  -> 768
#   BAAI/bge-small-en-v1.5 -> 384
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# Cross-encoder reranker (cuts the candidate pool down to the passages the
# answer is generated from). Measured on the eval set (docs/ASK_ITO_FAST_RAG_IMPLEMENTATION_REPORT.md):
#   BAAI/bge-reranker-base               -> best ranking; ~8 s/query on a 4-core CPU (pool 20, 512 tokens)
#   cross-encoder/ms-marco-MiniLM-L-6-v2 -> ~0.8 s/query, small gain over no reranker
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_POOL=20
RERANK_MAX_LENGTH=512

# ---------------------------------------------------------------------------
# LLM provider
#   LLM_MODE=ollama -> local Ollama native API (default; the compose `ollama` service)
#   LLM_MODE=openai -> an OpenAI-compatible server running locally (llama.cpp, vLLM, ...)
#   LLM_MODE=mock   -> deterministic offline stub, no model required (dev/tests)
# ---------------------------------------------------------------------------
LLM_MODE=ollama
LLM_BASE_URL=http://ollama:11434
LLM_API_KEY=ollama
# The model tag is set only here (falls back to the same tag in app/config.py).
# Pull it once: ./askito model   (prints the quantization Ollama reports)
#   qwen3.5:9b-q8_0   -> default: Q8_0 weights (~9.5 GB model file; registry
#                        manifest verified as file_type Q8_0)
#   qwen3.5:9b-q4_K_M -> baseline / rollback: Q4_K_M weights (~5.6 GB; the same
#                        manifest as qwen3.5:9b). Use it if Q8_0 does not fit in RAM:
#                        measured Ollama RSS peak 12.3 GB (Q8_0) vs 7.7 GB (Q4_K_M);
#                        on a 16 GB machine Q8_0 + the backend models ran out of memory.
# Weight quantization is not the KV-cache type (OLLAMA_KV_CACHE_TYPE, compose).
# Leave a role blank to fall back to LLM_DEFAULT_MODEL.
LLM_DEFAULT_MODEL=qwen3.5:9b-q8_0
LLM_AGENT_MODEL=
LLM_ANSWER_MODEL=
LLM_JUDGE_MODEL=
# Reasoning ("thinking") tokens are hidden but cost time; off is much faster.
LLM_THINK=false
# Keep the model loaded in RAM between searches (Ollama).
LLM_KEEP_ALIVE=24h
LLM_NUM_CTX=4096
# CPU threads for Ollama (0 = Ollama default). Physical core count is usually best.
LLM_NUM_THREAD=0
LLM_TIMEOUT_S=240

# Local-only policy: LLM/judge endpoints must be loopback (localhost, 127.0.0.0/8,
# ::1). Private-network, LAN and public addresses are refused. Keep true.
LLM_LOCAL_ONLY=true
# Explicit exception for container networks: these exact hostnames may resolve to
# private-network addresses (docker-compose sets "ollama"). Outside Docker, use
# LLM_BASE_URL=http://localhost:11434 and leave this empty.
LLM_ALLOWED_HOSTS=ollama
# RAGAS judge: a local model, ideally separate from the generator
# (falls back to LLM_DEFAULT_MODEL when empty). Judging runs one request at a time.
# LLM_JUDGE_MODEL=qwen3:14b
LLM_JUDGE_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# Search experience
# ---------------------------------------------------------------------------
# search   = hybrid retrieval, ranked sources only, no LLM call (default; ~0.1 s on CPU)
# overview = Answer: retrieval -> reranker -> ONE local LLM call (opt-in: the
#            "Generate AI answer" button in the UI; about a minute on a 4-core CPU)
# agentic  = "AI Mode" (opt-in): multi-step agent, several LLM calls; slow on CPU
DEFAULT_MODE=search
# Cross-encoder reranker per mode. Search off = fastest (RRF order; doc Recall@5
# 0.716 vs 0.784 with bge on the eval set). Answer on = better context for the LLM.
SEARCH_RERANK=false
ANSWER_RERANK=true
# Candidates per channel in the fast modes (0 = BM25_TOP_K / VECTOR_TOP_K = 50)
FAST_TOP_K=0
# Evidence cut-off on the reranker score (reranker units; 0 = off). Calibrated for
# bge-reranker-base; re-calibrate if RERANKER_MODEL changes.
FAST_MIN_EVIDENCE_SCORE=0.3
OVERVIEW_MAX_TOKENS=320
ANSWER_CACHE_ENABLED=true
# Load models at startup and pre-compute the featured queries in the background.
WARMUP_ON_START=true
PREWARM_FEATURED=true

# Wikipedia ingest. MediaWiki requires a descriptive User-Agent with a real
# contact (URL or email); a placeholder contact gets HTTP 403. Use your own.
WIKI_USER_AGENT=AskITO/0.1 (+https://github.com/Ozgurisikdamar/ASK-ITO)
WIKI_DELAY=1.0

# Retrieval / agent tuning
AGENT_MAX_ROUNDS=3
FINAL_K=5

# Frontend origin allowed by CORS (the nginx frontend proxies /api same-origin)
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Optional local Redis cache (L2 behind the in-process caches)
# ---------------------------------------------------------------------------
# Query embeddings, retrieval results (chunk ids + scores), a front cache for the
# PostgreSQL answer cache and the agent's deterministic tool calls. Local only:
# loopback, or a hostname listed in REDIS_ALLOWED_HOSTS that resolves to a
# private address (docker-compose runs the `redis` service and sets these).
# If Redis is down the app logs one warning and keeps using its in-process and
# PostgreSQL caches (REDIS_STRICT=true makes that an error). Redis never holds
# model KV tensors: the KV / prefix cache lives inside Ollama.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_ALLOWED_HOSTS=
REDIS_STRICT=false
REDIS_TTL_EMBEDDING_S=604800
REDIS_TTL_RETRIEVAL_S=86400
REDIS_TTL_ANSWER_S=86400
REDIS_TTL_TOOL_S=3600
REDIS_ANSWER_FRONT_CACHE=true
# Reuse analyse / rewrite / sufficiency results for an identical model + prompt
# (temperature 0, thinking off). Off = every agent run calls the model again.
AGENT_TOOL_CACHE=true
