# ---------------------------------------------------------------------------
# Ask ITO - example environment. Copy to .env and adjust. Never commit .env.
# (./askito up creates .env from this file when it is missing.)
# ---------------------------------------------------------------------------

# Database (inside docker-compose the host is `db`; natively use localhost)
DATABASE_URL=postgresql://askito:askito@db:5432/askito

# Embedding model (sentence-transformers). EMBEDDING_DIM must match the model:
#   BAAI/bge-base-en-v1.5  -> 768
#   BAAI/bge-small-en-v1.5 -> 384
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# Cross-encoder reranker (mandatory component; always runs).
#   cross-encoder/ms-marco-MiniLM-L-6-v2 -> fast on CPU (~0.5 s), default
#   BAAI/bge-reranker-base               -> slightly better ranking, ~3 s on CPU
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------------------------------------------------------------------------
# LLM provider
#   LLM_MODE=ollama -> local Ollama native API (default; the compose `ollama` service)
#   LLM_MODE=openai -> any OpenAI-compatible endpoint (e.g. Groq free tier, below)
#   LLM_MODE=mock   -> deterministic offline stub, no model required (dev/tests)
# ---------------------------------------------------------------------------
LLM_MODE=ollama
LLM_BASE_URL=http://ollama:11434
LLM_API_KEY=ollama
# Model names are read only from here, never hardcoded. Pull it once: ./askito model
#   qwen3:30b    -> 30B mixture-of-experts (~3B active): the fastest >=27B option on CPU
#   qwen3.8:27b  -> dense 27B: higher quality, several times slower on CPU
# Leave a role blank to fall back to LLM_DEFAULT_MODEL.
LLM_DEFAULT_MODEL=qwen3:30b
LLM_AGENT_MODEL=
LLM_ANSWER_MODEL=
LLM_JUDGE_MODEL=
# Reasoning ("thinking") tokens are hidden but cost time; off is much faster.
LLM_THINK=false
# Keep the model loaded in RAM between searches (Ollama).
LLM_KEEP_ALIVE=24h
LLM_NUM_CTX=4096
# CPU threads for Ollama (0 = Ollama default). Physical core count is usually best.
LLM_NUM_THREAD=0
LLM_TIMEOUT_S=240

# --- Optional: Groq free tier (fast cloud LLM, no GPU needed) -----------------
# Create a key at https://console.groq.com/keys and check model ids at
# https://console.groq.com/docs/models . Queries and retrieved Wikipedia passages
# are sent to Groq when this is enabled. Uncomment to use:
# LLM_MODE=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_key_here
# LLM_DEFAULT_MODEL=qwen/qwen3-32b
# LLM_EXTRA_BODY={"reasoning_effort":"none"}
#
# Fall back to the local model when the free-tier limit is hit (HTTP 429):
# LLM_FALLBACK_MODE=ollama
# LLM_FALLBACK_BASE_URL=http://ollama:11434
# LLM_FALLBACK_MODEL=qwen3:30b

# ---------------------------------------------------------------------------
# Search experience
# ---------------------------------------------------------------------------
# overview = instant results + streamed short AI overview (Google-like)
# agentic  = "AI Mode": multi-step agent (several LLM calls; slow on CPU)
DEFAULT_MODE=overview
OVERVIEW_MAX_TOKENS=320
ANSWER_CACHE_ENABLED=true
# Load models at startup and pre-compute the featured queries in the background.
WARMUP_ON_START=true
PREWARM_FEATURED=true

# Wikipedia ingest. MediaWiki requires a descriptive User-Agent with a real
# contact (URL or email); a placeholder contact gets HTTP 403. Use your own.
WIKI_USER_AGENT=AskITO/0.1 (+https://github.com/Ozgurisikdamar/ASK-ITO)
WIKI_DELAY=1.0

# Retrieval / agent tuning
AGENT_MAX_ROUNDS=3
FINAL_K=5

# Frontend origin allowed by CORS (the nginx frontend proxies /api same-origin)
FRONTEND_ORIGIN=http://localhost:5173
