{"kind": "unit", "key": "r1|qseed-quantum-001", "status": "ok", "at": "2026-11-03T07:11:09+00:00", "rep": 1, "question_id": "seed-quantum-001", "qtype": "quantum", "domain": "quantum", "total_ms": 45486.3, "app_timings": {"bm25": 0, "embedding": 205, "vector": 7, "rrf": 0, "results": 213, "rerank": 4660, "context": 0, "first_token": 15051, "answer": 40611, "total": 45486}, "app_llm_calls": 1, "rounds": null, "llm_calls": [{"role": "overview", "model": "qwen3.5:9b", "ms": 40611.0, "ttft_ms": 15051.1, "prompt_tokens": 827, "completion_tokens": 100, "prompt_eval_ms": 14893.3, "eval_ms": 25559.4, "load_ms": 1.0}], "resources": {"ollama_peak_rss_mb": 9779.7, "ollama_cpu_pct_avg": 351.5}, "trace_steps": [], "subquestions": null, "answer": "Quantum error correction (QEC) comprises techniques used in quantum memory and computing to protect quantum information from errors arising from decoherence and other sources of quantum noise [1][2]. It is essential for achieving fault-tolerant quantum computation because it addresses not only noise on stored information but also faulty gates, preparation, and measurements [2]. Additionally, QEC can be applied to quantum metrology to detect and correct errors or maintain high-precision states despite the presence of noise [3].", "citations": [{"n": 1, "chunk_id": 2795}, {"n": 2, "chunk_id": 3131}, {"n": 3, "chunk_id": 2815}], "source_chunk_ids": [2795, 3131, 2815, 5448], "source_doc_ids": [164, 255, 164, 253], "ranked_chunk_ids": [2795, 3131, 2815, 5448, 1613, 647, 1605, 5905, 646, 5904, 721, 411, 1829, 660, 687, 2623, 126, 2022, 3113, 142, 2187, 2048, 2192, 728, 820, 4978, 1142, 5393, 420, 1228], "metrics": {"chunk_recall@5": 0.0, "doc_recall@5": 1.0, "chunk_recall@10": 0.0, "doc_recall@10": 1.0, "chunk_mrr@10": 0.0, "doc_mrr@10": 1.0, "chunk_ndcg@10": 0.0, "doc_ndcg@10": 1.0}, "answer_metrics": {"not_found": false, "citation_id_validity": null, "citation_coverage": 1.0, "uncited_sentence_rate": 0.0, "citation_gold_precision": 0.666666